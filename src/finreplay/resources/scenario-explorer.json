  "claim_boundary": "This catalog is a navigation layer over the canonical scenario catalog. Capability lenses and decision questions describe what a bounded public-data replay can demonstrate; they do not add evidence, change ReplayPack claims, establish causal effects, represent client work, or prove real-world decisions, deployment, adoption, or impact.",
  "lenses": [
    {
      "description": "Availability time, economic time, revisions, and later disclosures remain separate instead of being collapsed into hindsight.",
      "label": "Point-in-time integrity",
      "lens_id": "temporal-integrity",
      "question": "What was actually knowable at the decision boundary?",
      "short_label": "Temporal"
    },
    {
      "description": "Initial releases, revisions, arithmetic envelopes, and sampling limits stay visible; a heuristic range is never relabelled as a forecast or confidence interval.",
      "label": "Revision and range discipline",
      "lens_id": "revision-and-range",
      "question": "Does the conclusion survive vintage changes and an explicitly uncalibrated range?",
      "short_label": "Revision"
    },
    {
      "description": "Outcomes preserve breaches, inside-range results, reversals, and failed promotion instead of presenting only favorable cases.",
      "label": "Stress and uncertainty",
      "lens_id": "stress-and-uncertainty",
      "question": "Where does the predeclared boundary hold, breach, or remain unevaluable?",
      "short_label": "Stress"
    },
    {
      "description": "Cases cover bank funding, policy rates, cash balances, repo conditions, auctions, yield curves, credit, and market positioning with explicit claim limits.",
      "label": "Financial systems and markets",
      "lens_id": "financial-systems",
      "question": "How do funding, rates, liquidity, market structure, and balance-sheet constraints interact?",
      "short_label": "Finance"
    },
    {
      "description": "Only the seven-engine bank replays carry simulated execution and allocation artifacts; those values remain research boundaries, not performance.",
      "label": "Allocation and execution",
      "lens_id": "allocation-and-execution",
      "question": "What survives non-zero cost, capacity, and constrained allocation?",
      "short_label": "Allocation"
    },
    {
      "description": "Typed artifacts, input locks, deterministic archives, hashes, evidence classes, and negative claim boundaries make the workflow auditable.",
      "label": "Data systems and governance",
      "lens_id": "systems-and-governance",
      "question": "Can another person trace the inputs, transformations, claims, and exclusions?",
      "short_label": "Governance"
    },
    {
      "description": "Labor, inflation, fiscal, monetary, trade, and facility data are treated as population-level or system-level signals, not individual outcomes or policy-effectiveness proof.",
      "label": "Policy and population signals",
      "lens_id": "policy-and-population",
      "question": "What can an aggregate official indicator support without becoming a causal policy claim?",
      "short_label": "Policy"
    },
    {
      "description": "Household-facing indicators support bounded behavioral hypotheses while preserving the gap between aggregate movement and individual intent.",
      "label": "Households and behavior",
      "lens_id": "households-and-behavior",
      "question": "What do aggregate spending, saving, credit, and housing signals reveal—and what motives remain unobserved?",
      "short_label": "Households"
    },
    {
      "description": "Housing starts, construction spending, house prices, and new-home sales expose spatially relevant evidence while stopping short of local regeneration or equity claims.",
      "label": "Housing, construction, and place",
      "lens_id": "housing-and-place",
      "question": "How do national housing and construction indicators change a place-based question without answering it?",
      "short_label": "Housing"
    },
    {
      "description": "Energy stocks, production, orders, trade, and producer or cross-border prices provide bounded operational signals without firm-level causal attribution.",
      "label": "Real-economy operations",
      "lens_id": "real-economy-operations",
      "question": "How do production, inventory, trade, and price shocks move through an operating environment?",
      "short_label": "Operations"
    }
  ],
